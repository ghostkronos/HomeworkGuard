<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ProductionKiosk)' == 'true'">
    <DefineConstants>$(DefineConstants);PRODUCTION_KIOSK</DefineConstants>
  </PropertyGroup>
</Project>
