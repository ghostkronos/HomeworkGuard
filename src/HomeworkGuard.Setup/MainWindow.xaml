<Window x:Class="HomeworkGuard.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HomeworkGuard Kurulum"
        Width="760" Height="740"
        MinWidth="680" MinHeight="640"
        Background="#1D2229"
        TextElement.Foreground="#F3F4F6"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="RootContainer" Margin="22" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootSlide" Y="12"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Minimal Header -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="18,15">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right" x:Name="EnvBadge" CornerRadius="7" Padding="11,5" VerticalAlignment="Center" Background="#162925" BorderBrush="#10B981" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="EnvDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,7,0"/>
                        <TextBlock x:Name="EnvBadgeText" Text="Ortam kontrol ediliyor..." FontSize="11.5" FontWeight="SemiBold" Foreground="#A7F3D0"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#132A27" BorderBrush="#0D9488" BorderThickness="1" Margin="0,0,13,0">
                        <Viewbox Width="18" Height="18">
                            <Path Data="M12,2 L4,5.5 V11.2 C4,16.4 7.4,21.1 12,22.5 C16.6,21.1 20,16.4 20,11.2 V5.5 L12,2 Z"
                                  Stroke="#2DD4BF" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"/>
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="HomeworkGuard Kurulum" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Ödev doğrulama servisini, zaman kurallarını ve bildirimleri yapılandırın."
                                   Foreground="#9CA3AF" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Contextual Help Popover Drawer -->
        <Border x:Name="HelpDrawer" Grid.Row="1" Visibility="Collapsed" Background="#142229" BorderBrush="#0D9488" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Anladım" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11.5" Margin="12,0,0,0" VerticalAlignment="Center" Click="CloseHelp_Click"/>
                <StackPanel>
                    <TextBlock x:Name="HelpTitleText" FontWeight="SemiBold" FontSize="12.5" Foreground="#5EEAD4"/>
                    <TextBlock x:Name="HelpBodyText" TextWrapping="Wrap" FontSize="12" Foreground="#D1D5DB" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Scrollable Form + Recovery + Log -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Host Safety Guard -->
                <Border x:Name="HostWarningBanner" Visibility="Collapsed" Background="#28151B" BorderBrush="#9F1239" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="HostWarningText" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#FDA4AF"
                                   Text="Bu bilgisayar sanal makine gibi görünmüyor. Kiosk kilidi aktif edildiğinde yalnızca Yönetici Şifresi veya Recovery Key ile çıkılabilir."/>
                        <CheckBox x:Name="ConfirmHostInstallCheck" Content="Bu bilgisayara tam Kiosk koruması kurmayı onaylıyorum."
                                  Foreground="#FECDD3" Margin="0,8,0,0" Checked="SafetyCheck_Changed" Unchecked="SafetyCheck_Changed"/>
                    </StackPanel>
                </Border>

                <!-- Admin Password & Keys -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Yönetici ve Servis Anahtarları" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Yönetici Şifresi *" Foreground="#D1D5DB" FontSize="12"/>
                                    <Button Style="{StaticResource HelpBadgeButton}" Tag="admin_pass" Click="Help_Click"
                                            ToolTip="Kilit ekranında Ctrl+Alt+Shift+F12 ile yönetici panelini açmak ve sistem ayarlarını değiştirmek için en az 6 karakterli şifre belirleyin."/>
                                </StackPanel>
                                <PasswordBox x:Name="AdminPassBox" Style="{StaticResource DarkPasswordBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Yönetici Şifresi (Tekrar) *" Foreground="#D1D5DB" FontSize="12" Margin="0,0,0,5"/>
                                <PasswordBox x:Name="AdminPassConfirmBox" Style="{StaticResource DarkPasswordBox}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,5">
                            <TextBlock Text="Gemini API Key" Foreground="#D1D5DB" FontSize="12"/>
                            <Button Style="{StaticResource HelpBadgeButton}" Tag="gemini_key" Click="Help_Click"
                                    ToolTip="Google AI Studio (aistudio.google.com/apikey) üzerinden Google hesabınızla ücretsiz oluşturabilirsiniz."/>
                        </StackPanel>
                        <TextBox x:Name="GeminiKeyBox" Style="{StaticResource DarkTextBox}"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Telegram Bot Token" Foreground="#D1D5DB" FontSize="12"/>
                                    <Button Style="{StaticResource HelpBadgeButton}" Tag="tg_token" Click="Help_Click"
                                            ToolTip="Telegram'da @BotFather botuna /newbot yazarak yeni bot oluşturup verdiği token'ı buraya yapıştırın."/>
                                </StackPanel>
                                <TextBox x:Name="TelegramTokenBox" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Admin Chat ID" Foreground="#D1D5DB" FontSize="12"/>
                                    <Button Style="{StaticResource HelpBadgeButton}" Tag="tg_chat" Click="Help_Click"
                                            ToolTip="Telegram'da @userinfobot botuna mesaj atarak kendi sayısal ID numaranızı öğrenebilirsiniz."/>
                                </StackPanel>
                                <TextBox x:Name="AdminChatIdBox" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Schedule & Criteria -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock Text="Zamanlama ve Ödev Kuralı" FontSize="14.5" FontWeight="SemiBold"/>
                                <Button Style="{StaticResource HelpBadgeButton}" Tag="schedule" Click="Help_Click"
                                        ToolTip="Açılış/kapanış saatlerini ve ödev onaylandıktan sonraki günlük maksimum kullanım süresini (0 = sınırsız) ayarlayın."/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="Eğitim tarayıcısı: 12 Türkçe ders sitesi hazır" Foreground="#5EEAD4" FontSize="11.5"/>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Açılış (SS:dd)" Foreground="#D1D5DB" FontSize="12" Margin="0,0,0,5"/>
                                <TextBox x:Name="StartTimeBox" Text="10:00" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Gece Kilidi (SS:dd)" Foreground="#D1D5DB" FontSize="12" Margin="0,0,0,5"/>
                                <TextBox x:Name="EndTimeBox" Text="22:00" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Günlük Süre (dk, 0=∞)" Foreground="#D1D5DB" FontSize="12" Margin="0,0,0,5"/>
                                <TextBox x:Name="MaxUsageBox" Text="0" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Uyarı (dk önce)" Foreground="#D1D5DB" FontSize="12" Margin="0,0,0,5"/>
                                <TextBox x:Name="WarningMinBox" Text="10" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,5">
                            <TextBlock Text="Günlük Ödev Kriteri" Foreground="#D1D5DB" FontSize="12"/>
                            <Button Style="{StaticResource HelpBadgeButton}" Tag="criteria" Click="Help_Click"
                                    ToolTip="Yapay zekanın öğrenci ödevini onaylarken arayacağı şartları yazın. Daha sonra Yönetici Panelinden veya Telegram'dan da güncellenebilir."/>
                        </StackPanel>
                        <TextBox x:Name="CriteriaBox" Style="{StaticResource DarkTextBox}" TextWrapping="Wrap" AcceptsReturn="True" Height="56"
                                 Text="Günün ödevinden en az 10 soru çözülmüş ve işlem adımları açıkça yazılmış olmalıdır."/>

                        <Expander x:Name="WeeklyExpander" Margin="0,12,0,0" Foreground="#5EEAD4" IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="Haftalık Gün Bazlı Süre &amp; Saat Planı (Pazartesi – Pazar Özelleştir)"
                                           Foreground="#5EEAD4" FontSize="12.5" FontWeight="SemiBold" Cursor="Hand"/>
                            </Expander.Header>
                            <StackPanel Margin="0,10,0,0">
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="Üstteki Geneli Tüm Günlere Uygula" IsTabStop="False"
                                            Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Click="SyncWeeklyFromGeneral_Click"/>
                                    <TextBlock Text="Her gün için farklı açılış/kapanış saati veya dakika limiti (0 = Sınırsız) belirleyin:"
                                               Foreground="#9CA3AF" FontSize="11.5" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="75"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Gün" Foreground="#9CA3AF" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="Açılış" Foreground="#9CA3AF" FontSize="11"/>
                                    <TextBlock Grid.Column="3" Text="Kapanış" Foreground="#9CA3AF" FontSize="11"/>
                                    <TextBlock Grid.Column="5" Text="Süre (dk)" Foreground="#9CA3AF" FontSize="11"/>
                                    <TextBlock Grid.Column="7" Text="Kapalı" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Center"/>
                                </Grid>
                                <ItemsControl x:Name="SetupWeeklyItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="95"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="75"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DayName}" VerticalAlignment="Center" FontSize="12" Foreground="#E5E7EB"/>
                                                <TextBox Grid.Column="1" Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Padding="8,4" FontSize="12"/>
                                                <TextBox Grid.Column="3" Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Padding="8,4" FontSize="12"/>
                                                <TextBox Grid.Column="5" Text="{Binding MaxMinutesText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Padding="8,4" FontSize="12"/>
                                                <CheckBox Grid.Column="7" IsChecked="{Binding IsBlocked}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Recovery Key Result Banner -->
                <Border x:Name="RecoveryResultCard" Visibility="Collapsed" Background="#0E241C" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12" Opacity="0">
                    <StackPanel>
                        <TextBlock Text="Kurulum Tamamlandı — Kurtarma Anahtarınızı Saklayın" FontSize="14.5" FontWeight="SemiBold" Foreground="#A7F3D0"/>
                        <TextBlock Text="İnternet olmadığında yönetici panelini açmak için aşağıdaki 24 haneli anahtarı güvenli bir yere kaydedin:"
                                   TextWrapping="Wrap" Foreground="#D1FAE5" FontSize="12" Margin="0,4,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RecoveryKeyBox" Grid.Column="0" IsReadOnly="True" FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                     Background="#081712" Foreground="#6EE7B7" BorderBrush="#10B981" Padding="12,9"/>
                            <Button x:Name="CopyKeyBtn" Grid.Column="1" Content="Kopyala" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="CopyKey_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Live Log -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Kurulum Günlüğü" FontSize="12.5" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <TextBox x:Name="LogBox" IsReadOnly="True" IsTabStop="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Height="105" Background="#13161A" Foreground="#9CA3AF" BorderBrush="#262B33"
                                 FontFamily="Consolas" FontSize="11.5" Padding="10"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="UninstallBtn" Grid.Column="0" Content="Korumayı Kaldır" Style="{StaticResource GhostDangerButton}" Click="Uninstall_Click"/>
            <Button x:Name="CloseBtn" Grid.Column="2" Content="Kapat" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Close_Click"/>
            <Button x:Name="InstallBtn" Grid.Column="3" Content="Kurulumu Başlat" Style="{StaticResource PrimaryButton}" Click="Install_Click"/>
        </Grid>
    </Grid>
</Window>
