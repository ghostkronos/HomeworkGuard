<Window x:Class="HomeworkGuard.UI.AdminAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yönetici Girişi"
        Width="470"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="True"
        Background="Transparent">
    <Border Margin="12" Style="{StaticResource CardBorder}" Background="#171A1E" BorderBrush="#333A45" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="15" Click="Cancel_Click" ToolTip="Kapat"/>
                <TextBlock Text="Yönetici Doğrulaması" FontSize="18" FontWeight="SemiBold" Foreground="#F3F4F6" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock Grid.Row="1" Margin="0,8,0,16" TextWrapping="Wrap" Foreground="#9CA3AF" FontSize="12.5" LineHeight="18"
                       Text="Yönetici şifrenizi, Telegram /acil_kod bilgisini veya 24 haneli kurtarma anahtarınızı girin."/>

            <PasswordBox x:Name="CredentialBox" Grid.Row="2" Style="{StaticResource DarkPasswordBox}" KeyDown="CredentialBox_KeyDown"/>

            <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="0,10,0,0" Foreground="#FDA4AF" TextWrapping="Wrap" FontSize="12" MinHeight="18"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Vazgeç" Style="{StaticResource SecondaryButton}" Width="96" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button x:Name="VerifyBtn" Content="Giriş Yap" Style="{StaticResource PrimaryButton}" Width="120" Click="Verify_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
