<Window x:Class="HomeworkGuard.UI.AdminConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HomeworkGuard Yönetici Konsolu"
        Width="940" Height="700"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        Background="#111315">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Yönetici Konsolu" FontSize="19" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                <TextBlock x:Name="AuthMethodText" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Bugünlük Aç" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="ForceUnlock_Click"/>
                <Button Content="Hemen Kilitle" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ForceLock_Click"/>
                <Button Content="Tam Yönetici Modu (Bakım)" Style="{StaticResource DangerButton}" Click="SafeExit_Click"
                        ToolTip="Kiosk ekranını, dosya koruma kilitlerini ve Görev Yöneticisi / Kayıt Defteri kısıtlamalarını geçici olarak kaldırıp bilgisayarda tam kontrol sağlar."/>
            </StackPanel>
        </DockPanel>

        <Border x:Name="RecoveryWarningBanner" Grid.Row="1" Background="#261E10" BorderBrush="#D97706" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock Foreground="#FDE68A" FontWeight="Medium" FontSize="12.5"
                       Text="Kurtarma yöntemi ile giriş yaptınız. Aşağıdan yeni bir yönetici şifresi belirlemeniz önerilir."/>
        </Border>

        <TabControl Grid.Row="2" Foreground="#F3F4F6">
            <TabItem Header="Kurallar ve Ayarlar">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Zamanlama ve Ödev Kriteri" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Açılış Saati (SS:dd)" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,5"/>
                                        <TextBox x:Name="StartTimeBox" Style="{StaticResource DarkTextBox}" Text="10:00"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Gece Kilidi (SS:dd)" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,5"/>
                                        <TextBox x:Name="EndTimeBox" Style="{StaticResource DarkTextBox}" Text="22:00"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Günlük Süre (dk, 0=Sınırsız)" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,5"/>
                                        <TextBox x:Name="MaxUsageMinutesBox" Style="{StaticResource DarkTextBox}" Text="0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Kilit Öncesi Uyarı (dk)" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,5"/>
                                        <TextBox x:Name="WarningMinutesBox" Style="{StaticResource DarkTextBox}" Text="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Gemini Model Adı" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,5"/>
                                        <TextBox x:Name="GeminiModelBox" Style="{StaticResource DarkTextBox}" Text="gemini-3.5-flash-lite"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Günlük Ödev Kriteri" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,5"/>
                                <TextBox x:Name="CriteriaBox" Style="{StaticResource DarkTextBox}" AcceptsReturn="True" Height="64" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <DockPanel Margin="0,0,0,5">
                                    <Button DockPanel.Dock="Right" Content="Varsayılan Ders Sitelerini Yükle" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11.5" Click="LoadDefaultStudySites_Click"/>
                                    <TextBlock Text="Eğitim Tarayıcısı İzin Listesi (Her satıra bir adres)" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBox x:Name="WhitelistBox" Style="{StaticResource DarkTextBox}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="92"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="Geneli Tüm Günlere Uygula" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11.5" Click="ApplyDefaultToAllDays_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="Haftalık Gün Bazlı Süre &amp; Saat Planı" FontSize="14.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Hafta içi ve hafta sonu için ayrı saat aralığı, süre limiti (0 = Sınırsız) veya tam gün kilit belirleyin." FontSize="11.5" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>

                                <Grid Margin="4,0,4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Gün" Foreground="#6B7280" FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="Açılış (SS:dd)" Foreground="#6B7280" FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="3" Text="Kapanış (SS:dd)" Foreground="#6B7280" FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="5" Text="Süre (dk, 0=∞)" Foreground="#6B7280" FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="7" Text="Gün Kapalı" Foreground="#6B7280" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </Grid>

                                <ItemsControl x:Name="WeeklyScheduleItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DayName}" VerticalAlignment="Center" FontWeight="Medium" Foreground="#E5E7EB"/>
                                                <TextBox Grid.Column="1" Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Padding="8,5"/>
                                                <TextBox Grid.Column="3" Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Padding="8,5"/>
                                                <TextBox Grid.Column="5" Text="{Binding MaxMinutesText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Padding="8,5"/>
                                                <CheckBox Grid.Column="7" IsChecked="{Binding IsBlocked}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="API Anahtarları ve Güvenlik" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="GeminiStatusLabel" Text="Gemini API Key" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,5"/>
                                        <PasswordBox x:Name="GeminiKeyBox" Style="{StaticResource DarkPasswordBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="TelegramStatusLabel" Text="Telegram Bot Token" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,5"/>
                                        <PasswordBox x:Name="TelegramTokenBox" Style="{StaticResource DarkPasswordBox}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Yetkili Admin Telegram Chat ID" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,5"/>
                                        <TextBox x:Name="AdminChatIdBox" Style="{StaticResource DarkTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Yeni Yönetici Şifresi (isteğe bağlı)" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,5"/>
                                        <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource DarkPasswordBox}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Ayarları Kaydet" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="SaveSettings_Click"/>
                                    <Button Content="Yeni Kurtarma Anahtarı Üret" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="RotateRecoveryKey_Click"/>
                                    <Button Content="Korumayı Yeniden Devreye Al" Style="{StaticResource SecondaryButton}" Click="ResumeProtection_Click"
                                            ToolTip="Bakım modundan çıkıp kilit ve dosya korumasını yeniden başlatır."/>
                                </StackPanel>

                                <TextBox x:Name="NewRecoveryKeyOutput" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Margin="0,12,0,0" Visibility="Collapsed"
                                         FontFamily="Consolas" FontWeight="Bold" Foreground="#6EE7B7"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Güvenlik Günlüğü">
                <DataGrid x:Name="AuditGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#16191D" Foreground="#F3F4F6"
                          BorderBrush="#2A3038" BorderThickness="1" RowBackground="#1C2026" AlternatingRowBackground="#171A1E"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#262B33">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih (UTC)" Binding="{Binding TimestampUtc}" Width="165"/>
                        <DataGridTextColumn Header="Olay" Binding="{Binding EventType}" Width="190"/>
                        <DataGridTextColumn Header="Aktör" Binding="{Binding Actor}" Width="120"/>
                        <DataGridTextColumn Header="Detay" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Ödev Geçmişi">
                <DataGrid x:Name="AttemptsGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#16191D" Foreground="#F3F4F6"
                          BorderBrush="#2A3038" BorderThickness="1" RowBackground="#1C2026" AlternatingRowBackground="#171A1E"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#262B33">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding DateLocal}" Width="95"/>
                        <DataGridTextColumn Header="Aşama" Binding="{Binding Stage}" Width="140"/>
                        <DataGridCheckBoxColumn Header="Onay" Binding="{Binding Approved}" Width="60"/>
                        <DataGridTextColumn Header="Puan" Binding="{Binding Score}" Width="60"/>
                        <DataGridTextColumn Header="Özet" Binding="{Binding Summary}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusFooterText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#5EEAD4" FontSize="12.5"/>
            <Button DockPanel.Dock="Right" Content="Kapat" Style="{StaticResource SecondaryButton}" Width="105" Click="Close_Click"/>
        </DockPanel>
    </Grid>
</Window>
