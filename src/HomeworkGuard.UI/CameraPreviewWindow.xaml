<Window x:Class="HomeworkGuard.UI.CameraPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kamera Önizleme"
        Width="760" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Topmost="True"
        Background="#111315">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <ComboBox x:Name="CameraSelector" DockPanel.Dock="Right" Width="230"
                      Background="#1C2026" Foreground="#F3F4F6" BorderBrush="#2A3038"
                      SelectionChanged="CameraSelector_SelectionChanged" Visibility="Collapsed"/>
            <StackPanel>
                <TextBlock Text="Kamera ile Ödev Fotoğrafı Çek" FontSize="17" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                <TextBlock x:Name="CameraStatusText" Text="Kamera başlatılıyor..." FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#0D1014" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
            <Grid>
                <Image x:Name="LivePreviewImage" Stretch="Uniform"/>
                <StackPanel x:Name="LoadingOverlay" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="OverlayText" Text="Kamera görüntüsü hazırlanıyor..." FontSize="13.5" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="İptal" Style="{StaticResource SecondaryButton}"
                    Padding="18,10" Margin="10,0,0,0" Click="Cancel_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RetakeBtn" Content="Tekrar Çek" Style="{StaticResource SecondaryButton}"
                        Padding="16,10" Margin="0,0,10,0" Visibility="Collapsed" Click="Retake_Click"/>
                <Button x:Name="UsePhotoBtn" Content="Bu Fotoğrafı Kullan" Style="{StaticResource PrimaryButton}"
                        Padding="20,10" Visibility="Collapsed" Click="UsePhoto_Click"/>
                <Button x:Name="SnapBtn" Content="Fotoğrafı Çek" Style="{StaticResource PrimaryButton}"
                        Padding="22,10" IsEnabled="False" Click="Snap_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
