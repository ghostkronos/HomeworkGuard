  <ItemGroup>
    <ProjectReference Include="..\HomeworkGuard.Core\HomeworkGuard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" />
  </ItemGroup>
</Project>
