<Window x:Class="HomeworkGuard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="HomeworkGuard"
        Width="800" Height="600"
        MinWidth="760" MinHeight="560"
        Background="#111315"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Grid x:Name="RootContainer" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform Y="10"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Dev Sandbox Mode Banner -->
        <Border x:Name="DevSandboxBanner" Grid.Row="0" Background="#12232B" BorderBrush="#1E3A47" BorderThickness="0,0,0,1" Padding="14,7" Visibility="Collapsed">
            <DockPanel>
                <TextBlock Foreground="#7DD3FC" FontWeight="Medium" FontSize="11.5"
                           Text="Geliştirici Önizleme Modu — 800x600 pencere, klavye kilidi ve tam ekran koruma devre dışı"/>
                <TextBlock DockPanel.Dock="Right" Foreground="#38BDF8" FontSize="11" HorizontalAlignment="Right"
                           Text="Yönetici: Ctrl+Alt+Shift+F12"/>
            </DockPanel>
        </Border>

        <!-- Clean Minimal Top Bar -->
        <Border Grid.Row="1" Background="#16191D" BorderBrush="#262B33" BorderThickness="0,0,0,1" Padding="24,14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="9" Background="#132A27" BorderBrush="#0D9488" BorderThickness="1" Margin="0,0,12,0">
                        <Viewbox Width="16" Height="16">
                            <Path Data="M12,2 L4,5.5 V11.2 C4,16.4 7.4,21.1 12,22.5 C16.6,21.1 20,16.4 20,11.2 V5.5 L12,2 Z"
                                  Stroke="#2DD4BF" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"/>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="HomeworkGuard" FontSize="16.5" FontWeight="SemiBold" Foreground="#F3F4F6" VerticalAlignment="Center"/>

                    <Border x:Name="StateBadge" Background="#261E10" BorderBrush="#D97706" BorderThickness="1" CornerRadius="7" Padding="10,5" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StateDot" Width="6" Height="6" Fill="#F59E0B" Margin="0,0,7,0"/>
                            <TextBlock x:Name="StateBadgeText" Text="Bağlanıyor" FontSize="11.5" FontWeight="SemiBold" Foreground="#FCD34D"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Background="#1C2026" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="7" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="InternetDot" Width="6" Height="6" Fill="#6B7280" Margin="0,0,7,0"/>
                            <TextBlock x:Name="InternetBadgeText" Text="Kontrol ediliyor" FontSize="11.5" Foreground="#D1D5DB"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1C2026" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="7" Padding="11,5">
                        <TextBlock x:Name="ClockText" Text="--:--:--" FontSize="12" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#5EEAD4"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Fail-Secure / Warning Alert Banner -->
        <Border x:Name="AlertBanner" Grid.Row="2" Background="#28151B" BorderBrush="#6B2135" BorderThickness="0,0,0,1" Padding="24,10" Visibility="Collapsed">
            <TextBlock x:Name="AlertBannerText" Foreground="#FECDD3" FontWeight="Medium" FontSize="12.5" TextWrapping="Wrap"
                       Text="Ödev kontrolü için internet bağlantısı bekleniyor."/>
        </Border>

        <!-- Main Workspace -->
        <TabControl x:Name="MainTabs" Grid.Row="3" Margin="24,18,24,20" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Ödev Kontrolü">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1120">
                        <!-- Daily Goal Summary Strip -->
                        <Border Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,0,0,16">
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="ScheduleText" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top"
                                           FontSize="12" Foreground="#9CA3AF" Margin="16,0,0,0"/>
                                <StackPanel>
                                    <TextBlock Text="GÜNÜN HEDEFİ" FontSize="10.5" FontWeight="SemiBold" Foreground="#5EEAD4"/>
                                    <TextBlock x:Name="DailyCriteriaText" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="13.5" Foreground="#E5E7EB"
                                               Text="Yükleniyor..."/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Two-Column Submission & Evaluation Flow -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="320"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*" MinWidth="320"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Card: Upload / Dropzone / Camera -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Ödevini Paylaş" FontSize="15.5" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                                    <TextBlock Text="Fotoğraf, PDF veya kod dosyanı seç ya da sürükle." FontSize="12" Foreground="#9CA3AF" Margin="0,3,0,14"/>

                                    <!-- Interactive Drag & Drop Zone -->
                                    <Border x:Name="DropZoneBorder" Background="#13161A" BorderBrush="#2E3540" BorderThickness="1.5"
                                            CornerRadius="12" Height="185" Margin="0,0,0,12" AllowDrop="True"
                                            DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop"
                                            MouseLeftButtonUp="DropZone_Click" Cursor="Hand">
                                        <Grid Margin="10">
                                            <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/>
                                            <StackPanel x:Name="PreviewPlaceholderPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Border Width="42" Height="42" CornerRadius="21" Background="#1B2229" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                    <Viewbox Width="18" Height="18">
                                                        <Path Data="M12,16 V4 M12,4 L7,9 M12,4 L17,9 M4,17 V19 A2,2 0 0,0 6,21 H18 A2,2 0 0,0 20,19 V17"
                                                              Stroke="#5EEAD4" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                                    </Viewbox>
                                                </Border>
                                                <TextBlock x:Name="PreviewPlaceholderText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                                           Foreground="#9CA3AF" FontSize="12.5"
                                                           Text="Dosya seçmek için tıklayın veya sürükleyin&#x0a;JPG, PNG, PDF ya da kaynak kod (maks. 15 MB)"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="UploadFileBtn" Grid.Column="0" Content="Dosya Seç" Style="{StaticResource SecondaryButton}" Click="UploadFile_Click"/>
                                        <Button x:Name="CaptureWebcamBtn" Grid.Column="2" Content="Kamerayla Çek" Style="{StaticResource SecondaryButton}" Click="CaptureWebcam_Click"/>
                                    </Grid>

                                    <TextBlock x:Name="SelectedFileInfoText" FontSize="11.5" Foreground="#6B7280" Margin="0,0,0,10" Text="Henüz dosya seçilmedi"/>

                                    <TextBlock Text="Kısa Not (İsteğe bağlı)" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,5"/>
                                    <TextBox x:Name="StudentNoteBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>

                                    <Button x:Name="SubmitStage1Btn" Content="Ödevi Kontrol Et" Style="{StaticResource PrimaryButton}" Click="SubmitStage1_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Right Card: Stepper & AI Review -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Button x:Name="ResetSessionBtn" DockPanel.Dock="Right" Content="Yeni Ödev" Style="{StaticResource SecondaryButton}" Padding="11,5" FontSize="11.5" Click="ResetSession_Click"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Değerlendirme" FontSize="15.5" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                                            <TextBlock Text="Görsel kontrol ve 2 kısa pekiştirme sorusu" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Minimal 3-Step Indicator -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="Step1Pill" Grid.Column="0" Background="#142B28" BorderBrush="#0D9488" BorderThickness="1" CornerRadius="8" Padding="8,6">
                                            <TextBlock x:Name="Step1Text" Text="1. İnceleme" HorizontalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="#5EEAD4"/>
                                        </Border>
                                        <Border x:Name="Step2Pill" Grid.Column="2" Background="#16191D" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="8" Padding="8,6">
                                            <TextBlock x:Name="Step2Text" Text="2. Sorular" HorizontalAlignment="Center" FontSize="11.5" FontWeight="Medium" Foreground="#6B7280"/>
                                        </Border>
                                        <Border x:Name="Step3Pill" Grid.Column="4" Background="#16191D" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="8" Padding="8,6">
                                            <TextBlock x:Name="Step3Text" Text="3. Kilit Açılışı" HorizontalAlignment="Center" FontSize="11.5" FontWeight="Medium" Foreground="#6B7280"/>
                                        </Border>
                                    </Grid>

                                    <!-- Status & Feedback Bubble -->
                                    <Border Background="#13161A" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse x:Name="EvalPulseDot" Width="7" Height="7" Fill="#2DD4BF" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="StageStatusText" Text="Ödev bekleniyor" FontSize="12.5" FontWeight="SemiBold" Foreground="#5EEAD4"/>
                                            </StackPanel>
                                            <TextBlock x:Name="AiFeedbackText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12.5" LineHeight="19" Foreground="#D1D5DB"
                                                       Text="Ödevini yüklediğinde adımların incelenir ve içeriğe göre 2 kısa soru hazırlanır."/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Stage 2 Questions Panel -->
                                    <StackPanel x:Name="SocraticPanel" Visibility="Collapsed" Opacity="0">
                                        <TextBlock x:Name="Question1Label" TextWrapping="Wrap" FontWeight="Medium" FontSize="12.5" Foreground="#FDE68A" Margin="0,0,0,5"/>
                                        <TextBox x:Name="Answer1Box" Style="{StaticResource DarkTextBox}" AcceptsReturn="True" Height="58" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                        <TextBlock x:Name="Question2Label" TextWrapping="Wrap" FontWeight="Medium" FontSize="12.5" Foreground="#FDE68A" Margin="0,0,0,5"/>
                                        <TextBox x:Name="Answer2Box" Style="{StaticResource DarkTextBox}" AcceptsReturn="True" Height="58" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                        <Button x:Name="SubmitStage2Btn" Content="Cevapları Gönder ve Kilidi Aç" Style="{StaticResource PrimaryButton}" Click="SubmitStage2_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Çalışma Tarayıcısı">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Friendly Turkish Study Sites Strip -->
                    <WrapPanel x:Name="WhitelistButtonsPanel" Grid.Row="0" Margin="0,0,0,10"/>

                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Left" Content="◀" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,6,0" Click="BrowserBack_Click"/>
                        <Button DockPanel.Dock="Left" Content="↻" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0" Click="BrowserRefresh_Click"/>
                        <TextBox x:Name="BrowserUrlBox" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Padding="11,7"/>
                    </DockPanel>

                    <Border Grid.Row="2" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="12" Background="#16191D" ClipToBounds="True">
                        <Grid>
                            <wv2:WebView2 x:Name="EduWebView" NavigationStarting="EduWebView_NavigationStarting"/>
                            <TextBlock x:Name="WebViewFallbackText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" Foreground="#9CA3AF" Margin="24"
                                       Text="Ders çalışmak için yukarıdaki izinli eğitim sitelerinden birini seçebilirsiniz."/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
